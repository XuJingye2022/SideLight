<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <!-- 注意：不要在这里声明 System.Windows.Forms.ApplicationConfigurationSection。
       .NET Framework 4.8 下声明该节会让宿主启动时抛「配置系统未能初始化」（实测 0.31.x）。
       高分屏只走 app.manifest 的 PerMonitorV2；DPI 断言见 scripts/host-smoke.mjs。 -->
  <startup>
    <supportedRuntime version="v4.0" sku=".NETFramework,Version=v4.8" />
  </startup>
  <runtime>
    <!-- .NET 4.6+ 的 legacy 路径处理会把 >260 字符的路径与 \\?\ 前缀一起判死。
         关掉它，长路径才能真的打开。 -->
    <AppContextSwitchOverrides value="Switch.System.IO.UseLegacyPathHandling=false;Switch.System.IO.BlockLongPaths=false" />
  </runtime>
</configuration>
